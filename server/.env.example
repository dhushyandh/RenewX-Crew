# Server
PORT=3000
NODE_ENV=development
MONGODB_URI=

# Generate two independent random secrets (at least 32 characters each).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated exact web origins, e.g. https://renewx.example
CORS_ORIGINS=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Run the admin script only after the account has registered.
ADMIN_EMAIL=
